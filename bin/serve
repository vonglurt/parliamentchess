#!/bin/sh
# Serve Parliament Chess: sh bin/serve [port]   (default 8080; open http://localhost:8080 in Chrome)
cd "$(dirname "$0")/.." || exit 1
PORT="${1:-8080}"
PHP_BIN="${PHP_BIN:-$(command -v php 2>/dev/null || echo /opt/homebrew/bin/php)}"
export PHP_CLI_SERVER_WORKERS="${PHP_CLI_SERVER_WORKERS:-4}"
echo "Parliament Chess on http://localhost:$PORT  (workers: $PHP_CLI_SERVER_WORKERS)"
exec "$PHP_BIN" -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=64M -S "0.0.0.0:$PORT" -t public public/index.php
